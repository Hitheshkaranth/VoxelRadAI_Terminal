{
  "deploymentScope": "single-organization-private-installation",
  "clinicalValidation": false,
  "optionalAdapters": {
    "keycloakOidc": "implemented-disabled-until-configured",
    "s3VolumeStorage": "implemented-disabled-until-configured",
    "orthancDicomweb": "administrator-instance-import-disabled-until-configured",
    "liveProviderAcceptance": false,
    "note": "Boolean capabilities below describe the default deployment; OIDC does not enforce MFA on local password login."
  },
  "authentication": {
    "passwordSessions": true,
    "currentPasswordChange": true,
    "administratorIssuedRecoveryToken": true,
    "selfServiceEmailRecovery": false,
    "mfa": false,
    "sso": false
  },
  "data": {
    "ownerScopedImageStudies": true,
    "databaseBackedSessionsAndRateLimits": true,
    "expiringRevocableReportLinks": true,
    "fullVolumeObjectStorage": false,
    "multiTenantIsolation": false,
    "pacs": false,
    "perUserStorageAllowance": "default-10-GiB-admin-adjustable-enforced-on-study-saves-and-volume-uploads"
  },
  "operations": {
    "checksummedMigrations": true,
    "databaseReadiness": true,
    "processScopedMetrics": true,
    "requestIdLogsWithoutRequestContent": true,
    "durableInferenceQueue": "api-reads-leased-in-postgresql-with-workers",
    "centralizedTelemetry": false,
    "prometheusMetrics": "implemented-hidden-until-METRICS_TOKEN",
    "modelUpstreamPool": "least-loaded-with-circuit-breaker-and-pre-start-failover"
  },
  "externalRequirements": [
    "TLS termination, encryption at rest and managed secret provisioning",
    "Backup retention and tested restoration in the intended environment",
    "Independent security and accessibility review",
    "Representative load testing, monitoring and operational ownership",
    "Model service availability and independent clinical validation"
  ],
  "publicApi": {
    "serverToServerModelApi": "implemented-disabled-until-model-bridge-configured",
    "routes": [
      "GET /api/v1/models",
      "POST /api/v1/chat/completions",
      "POST /api/v1/reads",
      "GET /api/v1/reads/{id}",
      "DELETE /api/v1/reads/{id}"
    ],
    "authentication": "administrator-issued-bearer-keys-stored-as-sha256-hashes",
    "keyScope": "model-routes-only",
    "readIsolation": "organisation-record-id",
    "idempotencyScope": "api-key",
    "perKeyDailyReadCaps": true,
    "maxTokens": 1536,
    "signedTimestampedWebhooks": "implemented-disabled-until-API_WEBHOOK_SECRET",
    "trainingCaptureOfApiReads": false,
    "durableReadQueue": true,
    "webhookDeliveryLog": false,
    "readQueueBackPressure": "503-queue_full-before-counting"
  }
}
