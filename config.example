# Copy to .env and fill secrets. Use URL-safe random database passwords.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_ORIGIN=http://localhost:8088
ALLOW_INSECURE_LOCALHOST=true
WEB_PORT=8088
DB_POOL_SIZE=10
# External Neon databases can use DATABASE_DRIVER=neon (WebSockets on port 443).
# Default postgres uses the native PostgreSQL connection.
DATABASE_DRIVER=postgres
# Minutes without requests before a signed-in session ends (5–480, default 60).
SESSION_IDLE_MINUTES=60
# Hands-free report dictation (Sarvam AI speech-to-text, model saaras:v4). Leave empty to disable.
# The key stays on the server; browsers send audio to /api/speech/transcribe, which forwards it to Sarvam.
SARVAM_API_KEY=
# Model-improvement capture: de-identified analysed images, AI findings with reviewer decisions,
# AI draft vs signed report text, and failed/undone/corrected dictation clips (with audio).
# Off by default. To enable, set TRAINING_CAPTURE=on AND a long random TRAINING_PSEUDONYM_SECRET
# (e.g. `openssl rand -hex 32`); without the secret capture stays off. Each user must also opt in
# under Settings -> Data & storage. Records are deleted after the retention period.
TRAINING_CAPTURE=off
TRAINING_RETENTION_DAYS=365
# Required when capture is on: keys the one-way study/image/user pseudonyms. Keep it private and stable.
TRAINING_PSEUDONYM_SECRET=
# Server storage allowance per user, in GiB (saved scans, patient data, reports, analysis, feedback). Administrators
# can set a different allowance per user. Default 10.
STORAGE_QUOTA_GB=10
# Bearer token for Prometheus scrapes of the API (/metrics) and workers (:9090/metrics). Empty hides the routes.
METRICS_TOKEN=
# Dedicated-GPU overlay (compose.gpu.yaml): shared bridge secret (32+ chars), and read access to the private weights.
BRIDGE_SECRET=
HF_TOKEN=
MODEL_REVISION=
# Several model upstreams, comma-separated (ZeroGPU Space and/or GPU servers). The overlay defaults to its own GPU.
# MODEL_UPSTREAMS=https://your-space.hf.space/lmstudio,http://skanda-gpu:8000
